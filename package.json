{
  "name": "nova-ai",
  "version": "1.0.0",
  "main": "nova-server.txt",
  "scripts": {
    "start": "node nova-server.txt",
    "test:mobile-layout": "playwright test tests/mobile-layout.spec.mjs",
    "test:cloud-sync": "node --test scripts/cloud-sync-merge.test.cjs",
    "start:local": "node --env-file-if-exists=.env nova-server.txt",
    "test:timezone": "node --test scripts/timezone.test.cjs",
    "test:provider-http": "node --test scripts/provider-http.test.cjs",
    "test:image-privacy": "node --test scripts/image-privacy.test.cjs",
    "test:env-example": "node --test scripts/env-example.test.cjs",
    "test:a11y": "node --test scripts/accessibility-markup.test.cjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "express": "^4.19.2",
    "toidentifier": "^1.0.1"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "@playwright/test": "1.56.1"
  }
}
