{
  "name": "@nova/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:money": "vitest run src/money",
    "test:diwan": "vitest run src/diwan"
  },
  "dependencies": {
    "@nova/shared": "2.0.0",
    "@supabase/supabase-js": "2.119.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "express": "4.22.3",
    "express-rate-limit": "8.7.4",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "zod": "4.6.7",
    "multer": "2.5.0",
    "pdfjs-dist": "5.4.149"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "@types/multer": "2.0.0"
  }
}
