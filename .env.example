# Copy this file to .env for local development. Never commit .env or provider secrets.
# For Render, add only the required secret values in the service Environment settings.
# At least one server-side AI provider key is required for AI chat.

# Primary OpenAI-compatible provider (for example, OpenRouter)
LLM_KEY=
LLM_MODEL=
LLM_BASE=https://openrouter.ai/api/v1
LLM_FALLBACK_MODELS=
LLM_VISION_MODEL=

# Optional Groq provider. Set an explicit model only after checking its current availability and billing.
# The application intentionally does not assume a Groq model ID.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=

# OpenRouter: openrouter/free selects a currently available free model automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=

# Optional search providers; built-in public fallbacks remain available without these keys.
TAVILY_KEY=
BRAVE_KEY=

# Optional speech-to-text provider settings.
STT_MODEL=
STT_OFF=0

# Image generation settings. Paid image generation is explicitly disabled by default.
IMAGE_OFF=0
ALLOW_PAID_IMAGE=false
IMAGE_KEY=
IMAGE_MODEL=
IMAGE_BASE=
POLLI_KEY=
HORDE_API_KEY=
HORDE_BASE=

# Operator-only diagnostics. Keep both disabled except during a supervised live test.
SELFTEST_ON_START=0
LIVE_SELFTEST_ENABLED=0
