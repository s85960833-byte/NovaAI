NODE_ENV=development
APP_BASE_URL=http://localhost:4173
API_PORT=8787
DATABASE_URL=postgresql://local:local@127.0.0.1:5432/nova_test
SESSION_SECRET=replace-with-a-long-random-local-only-value
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_DEFAULT_MODEL=mock-safe
AI_VISION_MODEL=mock-vision
AI_GLOBAL_DAILY_SPEND_CAP_INR=0
AI_USER_DAILY_SPEND_CAP_INR=0
AI_KILL_SWITCH=true
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FILE_STORAGE_BUCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMS_PROVIDER_KEY=
ERROR_TRACKING_DSN=
ADMIN_EMAILS=

# AI provider is mock-only by default. Never put keys in browser variables.
AI_PROVIDER=mock
AI_MODEL=
AI_KILL_SWITCH=true
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_USD_INR=93.66
AI_GLOBAL_DAILY_SPEND_CAP_INR=0
AI_USER_DAILY_SPEND_CAP_INR=0
MOCK_FEATURES_ENABLED=true
MOCK_WEBHOOK_SECRET=replace-with-local-only-secret
