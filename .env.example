# Copy this file to .env for local development. Never commit .env or provider secrets.
# For Render, add only the required secret values in the service Environment settings.
# At least one server-side AI provider key is required for AI chat.

# Primary OpenAI-compatible provider (for example, OpenRouter)
LLM_KEY=
LLM_MODEL=
LLM_BASE=https://openrouter.ai/api/v1
LLM_FALLBACK_MODELS=
LLM_VISION_MODEL=
LLM_MAX_HISTORY=10
LLM_MAX_INPUT_TOKENS=5000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_VISION_BUDGET=6500
LLM_TIMEOUT_MS=90000

# Optional Groq provider. Set an explicit model only after checking its current availability and billing.
# The application intentionally does not assume a Groq model ID.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=

# OpenRouter: openrouter/free selects a currently available free model automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=

# Optional live-retrieval concurrency cap (process-local)
LIVE_CONCURRENCY=5

# Optional staged API authentication gate. Keep disabled until account UX and staging checks pass.
# Set to 1 only with the matching Supabase project URL and publishable key configured below.
NOVA_API_AUTH_REQUIRED=0
SUPABASE_URL=https://qrfwsewppafhxibdboam.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server listen port (Render supplies PORT automatically)
PORT=3000

# Optional search providers; built-in public fallbacks remain available without these keys.
TAVILY_KEY=
# Enable only after written permission for cross-customer caching is obtained.
TAVILY_SHARED_CACHE_ALLOWED=0
BRAVE_KEY=

# Optional speech-to-text provider settings.
STT_MODEL=
STT_OFF=0

# Image generation settings. Paid image generation is explicitly disabled by default.
IMAGE_OFF=0
ALLOW_PAID_IMAGE=false
IMAGE_KEY=
IMAGE_MODEL=
IMAGE_BASE=
# Keep off by default; only an eligible operator may explicitly approve hosted image-provider usage/costs.
NOVA_ALLOW_POLLINATIONS_SPEND=0
POLLI_KEY=
HORDE_API_KEY=
HORDE_BASE=

# Supabase Edge Function setting (set in Supabase Functions secrets, not Render unless running locally)
NOVA_BI_SITE_URL=https://novaai-4auo.onrender.com

# Operator-only diagnostics. Keep both disabled except during a supervised live test.
SELFTEST_ON_START=0
LIVE_SELFTEST_ENABLED=0
